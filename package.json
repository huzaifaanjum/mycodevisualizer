{
  "name": "mycodevisualizer",
  "version": "0.1.0",
  "private": true,
  "description": "Free, open tool that visualizes Java code step by step for Coding 101 students.",
  "license": "MIT",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "tracer:build": "bash tracer/scripts/build.sh",
    "tracer:test": "node tracer/scripts/test.mjs",
    "db:setup": "tsx --conditions=react-server scripts/db-setup.ts",
    "db:seed": "tsx --conditions=react-server scripts/seed-examples.ts",
    "sandbox:snapshot": "tsx --conditions=react-server scripts/build-sandbox-snapshot.ts",
    "check": "yarn lint && yarn typecheck && yarn test"
  },
  "dependencies": {
    "@auth/mongodb-adapter": "3.11.3",
    "@monaco-editor/react": "4.7.0",
    "@vercel/sandbox": "3.6.1",
    "@xyflow/react": "12.12.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.55.0",
    "monaco-editor": "0.57.0",
    "mongodb": "7.7.0",
    "nanoid": "6.0.2",
    "next": "16.4.0",
    "next-auth": "5.0.0-beta.32",
    "radix-ui": "1.8.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "0.0.1",
    "tailwind-merge": "3.7.0",
    "zod": "4.6.6"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "@tailwindcss/turbopack": "^4",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "6.1.2",
    "@vitest/coverage-v8": "5.0.3",
    "eslint": "^9",
    "eslint-config-next": "16.4.0",
    "jsdom": "30.1.2",
    "prettier": "3.9.10",
    "prettier-plugin-tailwindcss": "0.8.1",
    "tailwindcss": "^4",
    "tsx": "^4",
    "tw-animate-css": "1.4.0",
    "typescript": "^5",
    "vite": "8.3.4",
    "vitest": "5.0.3"
  },
  "engines": {
    "node": ">=22"
  },
  "dependenciesMeta": {
    "esbuild": {
      "built": true
    }
  },
  "packageManager": "yarn@4.18.1+sha512.b2e1e7524f654f2749d32b4ebcb4622473cb5bcbc485df2007e12a154e50162a4d795526768bc5f5b8f81717bfd79deb2472813d86fb5ae2eb551fa9c872b08f"
}

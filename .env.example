# Copy to .env.local for local development. Never commit real values.

# MongoDB Atlas connection string. Optional locally: without it, examples come from /content,
# sharing and sign-in are hidden, and rate limits are kept in memory.
MONGODB_URI=
MONGODB_DB=mycodevisualizer

# Auth.js (optional). Generate a secret with: openssl rand -base64 32
AUTH_SECRET=
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Salt for hashing IPs in rate-limit keys. Generate with: openssl rand -hex 32
IP_HASH_SALT=

# Where code runs: vercel-sandbox (production default), local (development default; runs the
# tracer jar on your machine, never allowed in production) or fixture (recorded traces, for tests).
EXECUTION_PROVIDER=
# Snapshot with JDK 21 + tracer.jar, created by `yarn sandbox:snapshot`.
VERCEL_SANDBOX_SNAPSHOT_ID=
# Local provider only.
TRACER_JAR_PATH=tracer/build/tracer.jar
GROK_API_KEY=
# ElevenLabs voice narration (optional). Without a key the narration buttons are hidden.
ELEVENLABS_API_KEY=
# voice id for the voice of the assistant
# Voice ID	Name
# cgSgspJ2msm6clMCkdW9
# Jessica — playful, bright, warm
# EXAVITQu4vr4xnSDxMaL
# Sarah — mature, reassuring
# FGY2WhTYpPnrIDTdsKH5
# Laura — enthusiast
# JBFqnCBsd6RMkjVDRZzb
# George — warm storyteller
# onwK4e9ZLuTAKqWW03F9
# Daniel — steady broadcaster
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_ID=
